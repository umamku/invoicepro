# PostHog Analytics (Daftar gratis di https://posthog.com)
# Dapatkan Project API Key di PostHog: Project Settings > Project API Key (contoh: phc_xxxx...)
VITE_POSTHOG_KEY=
# Host server PostHog: us (default) atau eu
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 / GA4 (Daftar gratis di https://analytics.google.com)
# Dapatkan Measurement ID di Admin > Data Streams > Web (contoh: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
